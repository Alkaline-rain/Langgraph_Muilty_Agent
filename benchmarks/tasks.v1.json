      ],
      "reference": {
        "prefix": "人工维护的参考实现，仅用于验证评测集，不提供给生成器",
        "imports": "",
        "code": "def solve(payload):\n    items = payload['items']\n    if not items:\n        return []\n    k = payload['k'] % len(items)\n    return items[-k:] + items[:-k]\n"
      }

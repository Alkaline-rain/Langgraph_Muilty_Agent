      "category": "sequence",
      "task": {
        "question": "实现同步函数 solve(payload)。payload.items 为数组，payload.k 为非负整数，向右循环移动 k 位；空数组返回空数组。",
        "execution_mode": "offline",
        "cases": [
          {
            "name": "case_1",
            "input": {
              "items": [
                1,

# Copy to .env locally. Do not commit real credentials.
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
SANDBOX_MODE=docker
SANDBOX_IMAGE=code-assistant-sandbox:offline-v1
# Optional when Docker is installed in a custom location:
# DOCKER_EXECUTABLE=C:\path\to\docker.exe
